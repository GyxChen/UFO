{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "UFO",
  "mainBinaryName": "UFO",
  "version": "1.0.0",
  "identifier": "com.ufo.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "floating",
        "title": "UFO launcher",
        "width": 45,
        "height": 45,
        "x": 24,
        "y": 24,
        "visible": true,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "additionalBrowserArgs": "--autoplay-policy=no-user-gesture-required --disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection"
      },
      {
        "label": "main",
        "title": "UFO",
        "width": 1000,
        "height": 750,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "skipTaskbar": true
      },
      {
        "label": "tooltip",
        "title": "UFO tooltip",
        "width": 300,
        "height": 260,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "focus": false,
        "focusable": false
      }
    ],
    "trayIcon": {
      "id": "main",
      "iconPath": "icons/icon.png",
      "tooltip": "UFO",
      "showMenuOnLeftClick": false
    },
    "security": {
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "script-src": "'self' http://ufo-plugin.localhost",
        "connect-src": "ipc: http://ipc.localhost http://ufo-plugin.localhost",
        "font-src": "'self' http://ufo-plugin.localhost",
        "img-src": "'self' asset: http://asset.localhost blob: data: http://ufo-plugin.localhost",
      "media-src": "'self' blob:",
        "style-src": "'unsafe-inline' 'self' http://ufo-plugin.localhost",
        "frame-src": "'self' http://ufo-plugin.localhost ufo-plugin: https:"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "wix": {
        "upgradeCode": "d7b89722-1c13-53c2-9ffb-886a20257da7",
        "fragmentPaths": ["windows/wix/path-fragment.wxs"],
        "componentRefs": ["UfoPathEnvironment"]
      },
      "nsis": {
        "installerHooks": "windows/nsis/path-hooks.nsh",
        "installMode": "currentUser"
      }
    }
  }
}
