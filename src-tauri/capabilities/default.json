{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Window controls used by the floating launcher.",
  "windows": ["main", "floating", "tooltip"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:window:allow-set-position",
    "core:window:allow-set-size",
    "core:window:allow-start-dragging",
    "core:window:allow-unminimize",
    "allow-get-status-snapshot",
    "allow-get-proxy-resolvers",
    "allow-get-floating-module-config",
    "allow-get-endpoint-profiles",
    "allow-get-flow-results",
    "allow-get-session-records",
    "allow-is-left-mouse-pressed"
  ]
}
