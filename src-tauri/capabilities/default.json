{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Window controls and read-only commands shared by every window (launcher, main, tooltip, detached panel windows).",
  "windows": ["main", "floating", "tooltip", "script-editor", "status-log", "plugin-log"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-close",
    "core:window:allow-set-focus",
    "core:window:allow-set-position",
    "core:window:allow-set-size",
    "core:window:allow-start-dragging",
    "core:window:allow-set-always-on-top",
    "core:window:allow-unminimize",
    "allow-get-status-snapshot",
    "allow-dismiss-status-session",
    "allow-set-tooltip-interactive",
    "allow-take-panel-payload",
    "allow-get-proxy-resolvers",
    "allow-get-floating-module-config",
    "allow-get-endpoint-profiles",
    "allow-get-flow-results",
    "allow-get-session-records",
    "allow-get-status-log",
    "allow-get-plugins",
    "allow-plugin-log-writes",
    "allow-plugin-events",
    "allow-plugin-capability-calls",
    "allow-light-sounds",
    "allow-is-left-mouse-pressed"
  ]
}
