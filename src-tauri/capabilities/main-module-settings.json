{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-module-settings",
  "description": "Write access for floating module settings in the main window and the panel windows it opens.",
  "windows": ["main", "status-log"],
  "permissions": [
    "allow-set-floating-module-config",
    "allow-manage-endpoint-profiles",
    "allow-save-endpoint-flow",
    "allow-run-flow-test",
    "allow-manage-flow-secrets",
    "allow-manage-push",
    "allow-manage-session-records",
    "allow-manage-status-log",
    "dialog:allow-save",
    "allow-search-weather-city",
    "allow-test-weather-connection",
    "allow-manage-weather-secret",
    "allow-list-todo-projects",
    "allow-test-todo-connection",
    "allow-manage-todo-secret",
    "allow-create-todo-task",
    "allow-complete-todo-task",
    "allow-postpone-todo-task",
    "allow-delete-todo-task",
    "allow-reopen-todo-task"
  ]
}
