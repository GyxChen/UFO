{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-module-settings",
  "description": "Write access for floating module settings in the main window and the panel windows it opens.",
  "windows": ["main", "status-log", "plugin-log"],
  "permissions": [
    "allow-set-floating-module-config",
    "allow-manage-endpoint-profiles",
    "allow-save-endpoint-flow",
    "allow-run-flow-test",
    "allow-manage-flow-secrets",
    "allow-manage-push",
    "allow-manage-session-records",
    "allow-manage-status-log",
    "dialog:allow-save",
    "allow-manage-plugins",
    "allow-manage-plugin-logs",
    "allow-open-panel-window",
    "dialog:allow-open"
  ]
}
