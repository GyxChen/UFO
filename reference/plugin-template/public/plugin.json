{
  "manifestVersion": 1,
  "apiVersion": 1,
  "id": "my-plugin",
  "name": "我的组件",
  "version": "1.0.0",
  "description": "模板：四种挂载点各占一处，改这份清单就能裁掉不要的那几处",
  "entry": "main.js",
  "surfaces": {
    "cell": 1,
    "tooltip": { "own": true, "size": [320, 160] },
    "extension": { "into": "agent-status", "maxRows": 2 },
    "settings": true
  },
  "permissions": ["storage", "events:agent", "fs"],
  "hosts": []
}
