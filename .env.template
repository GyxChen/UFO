VITE_DEVTOOLS=false
# 窗口 devtools 开关（仅调试构建生效），默认全关：
#   UFO_DEVTOOLS=true             → main / floating / tooltip 三个窗口全开
#   UFO_DEVTOOLS=floating,tooltip → 只开点名窗口（逗号或空格分隔，大小写不敏感）
# 取值来源优先级：进程环境变量 > 本文件（由 src-tauri/build.rs 构建期注入，改完需重新构建）。
# 注意：这只管 webview 的 devtools，前端的 Vue devtools 见上面的 VITE_DEVTOOLS。
UFO_DEVTOOLS=true

# 开发用：>0 注入假 agent，测悬浮窗多 agent；正式保持 0
VITE_AGENT_STATUS_MOCK_COUNT=0
# 假会话是否带 flashing；默认 true
# VITE_AGENT_STATUS_MOCK_FLASHING=false
# 排除标签列表：逗号分隔（尖括号会被剥掉，写 <name> 或 name 都可以）。
# 出现在 Claude Code 上报的 user prompt 中的这些「元标签」，连同其包裹的整段内容
# 一起剔除，只留下用户真正输入的文本（仅处理 prompt 字段）。
# 该列表在构建期由 src-tauri/build.rs 从本文件读出并注入二进制（hook 进程运行时读不到仓库 .env），
# 因此改完这里需要重新构建才生效。
#
# 已知会混进 prompt 的标签（来自 Claude Code 自身注入与 hook 透传的环境信息）：
UFO_STRIP_TAGS=<ide_opened_file>,<system-reminder>,<local-command>,<bash_input>,<bash_output>,<cli-message>,<command-message>,<command-name>,<command-args>,<allowed-prompts>,<env>,<permission_mode>,<task-notification>
#
# 通用标签引擎的完整规则表（可选，优先级高于上面的 UFO_STRIP_TAGS）：逗号分隔，每项 name（= drop）
# 或 name:drop / name:extract。drop 删标签连同内文；extract 只留标签内正文（正文被平台包进
# 标签里的形态，如 Qoder 设置目标那轮的 <untrusted_objective>）。规则表全平台共用一份，
# 动作由各适配器自己挑（claude.rs 只取 drop 与 claude_*，qoder.rs 只取 extract 与 qoder_*）。
# 留空即用 compat/mod.rs 里的内置默认。
# UFO_TAG_RULES=system-reminder:drop,untrusted_objective:extract
