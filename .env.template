VITE_DEVTOOLS=false
# 开发用：>0 注入假 agent，测悬浮窗多 agent；正式保持 0
VITE_AGENT_STATUS_MOCK_COUNT=0
# 假会话是否带 flashing；默认 true
# VITE_AGENT_STATUS_MOCK_FLASHING=false
# 排除标签列表：逗号分隔（尖括号会被剥掉，写 <name> 或 name 都可以）。
# 出现在 Claude Code 上报的 user prompt 中的这些「元标签」，连同其包裹的整段内容
# 一起剔除，只留下用户真正输入的文本（仅处理 prompt 字段）。
# 该列表在构建期由 src-tauri/build.rs 从本文件读出并注入二进制（hook 进程运行时读不到仓库 .env），
# 因此改完这里需要重新构建才生效。
#
# 已知会混进 prompt 的标签（来自 Claude Code 自身注入与 hook 透传的环境信息）：
UFO_STRIP_TAGS=<ide_opened_file>,<system-reminder>,<local-command>,<bash_input>,<bash_output>,<cli-message>,<command-message>,<command-name>,<command-args>,<allowed-prompts>,<env>,<permission_mode>,<task-notification>
