VITE_DEVTOOLS=false
# 窗口 devtools 开关（仅调试构建生效），默认全关：
#   UFO_DEVTOOLS=true             → main / floating / tooltip 三个窗口全开
#   UFO_DEVTOOLS=floating,tooltip → 只开点名窗口（逗号或空格分隔，大小写不敏感）
# 取值来源优先级：进程环境变量 > 本文件（由 src-tauri/build.rs 构建期注入，改完需重新构建）。
# 注意：这只管 webview 的 devtools，前端的 Vue devtools 见上面的 VITE_DEVTOOLS。
UFO_DEVTOOLS=true

# 开发用：>0 注入假 agent，测悬浮窗多 agent；正式保持 0
VITE_AGENT_STATUS_MOCK_COUNT=0
# 假会话是否带 flashing；默认 true
# VITE_AGENT_STATUS_MOCK_FLASHING=false
# 提问标签规则表：**一个平台一个键**，只影响该平台上报的 `prompt`（其它字段一律不动）。
# 语法：逗号分隔，每项 `name`（= drop）或 `name:drop` / `name:extract`；尖括号与空白都会被剥掉。
#   drop    删掉 <t>…</t> 连同内文 —— 平台注入的元信息（提醒、环境说明、命令模板）。
#   extract 只保留 <t>…</t> 内的正文、标签外全丢 —— 用户正文被平台包进标签里的形态
#           （如 Qoder 设置目标那一轮把提问整个换成三千字 harness 模板，目标在 <untrusted_objective> 里）。
# 留空即用各适配器自己的内置默认（compat/claude.rs / compat/qoder.rs 的 DEFAULT_TAG_RULES）；
# 构建期由 src-tauri/build.rs 从本文件注入二进制（hook 进程运行时读不到仓库 .env），改完要重新构建。
#
# Claude Code 已知会混进提问的标签（自身注入 + hook 透传的环境信息），默认全是 drop：
UFO_TAG_RULES_CLAUDE=<ide_opened_file>,<system-reminder>,<local-command>,<bash_input>,<bash_output>,<cli-message>,<command-message>,<command-name>,<command-args>,<allowed-prompts>,<env>,<permission_mode>,<task-notification>
#
# Qoder：目前只有 /goal 那一轮的模板需要解包。extract 规则默认带「文本以 `A goal has been set.`
# 开头才生效」的门槛（门槛写在 compat/qoder.rs —— 环境变量只能写 name:action，写不出条件）。
UFO_TAG_RULES_QODER=untrusted_objective:extract
